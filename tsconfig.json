{
  "//": "Config CLIENT + GLOBAL. Hérite de tsconfig.base.json (cible, module, strict, décorateurs legacy).",
  "//2": "experimentalDecorators + useDefineForClassFields:false vivent dans la base — obligatoires pour les schémas @colyseus/schema (sinon __decorateElement casse au boot).",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@city/*": ["./src/components/city/*"],
      "@game/*": ["./src/game/*"],
      "@world/*": ["./src/world/*"],
      "@server/*": ["./src/server/*"],
      "@intellectus/*": ["./src/intellectus/*"],
      "@admin/*": ["./src/admin/*"],
      "@store/*": ["./src/store/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@lib/*": ["./src/lib/*"]
    },

    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "drizzle.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "build", ".vite"]
}