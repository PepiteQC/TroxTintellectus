{
  "name": "troxtworld",
  "version": "1.0.0",
  "description": "Simulation RP 3D du Comte de Portneuf - Three.js + Colyseus + Drizzle + Intellectus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "concurrently -n WEB,API,GAME -c blue,cyan,green \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:server\"",
    "dev:full": "concurrently -n WEB,API,GAME,ADMIN,TROXT -c blue,cyan,green,magenta,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:server\" \"npm:dev:admin\" \"npm:dev:troxt\"",
    "dev:web": "vite --host 0.0.0.0 --port 8080",
    "dev:api": "tsx watch client/src/main.ts",
    "dev:server": "tsx watch server/troxt-server.ts",
    "dev:admin": "tsx watch server/src/admin/index.ts",
    "dev:troxt": "tsx watch server/troxt-server.ts",
    "start": "tsx server/troxt-server.ts",
    "start:api": "tsx client/src/main.ts",
    "start:troxt": "tsx server/troxt-server.ts",
    "setup": "npm install && npm run db:create && npm run db:push",
    "db:create": "tsx create-db.ts --env=.env.development",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{client,server,database}/**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"{client,server,database}/**/*.{ts,tsx,js,mjs,json,css}\"",
    "typecheck": "npm run typecheck:server",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:legacy": "tsc -p tsconfig.legacy.json --noEmit",
    "typecheck:all": "npm run typecheck:server && npm run typecheck:legacy",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "audit:reach": "node scripts/audit_reachability.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "qa:realtime": "node scripts/qa-realtime-rooms.mjs",
    "test": "echo \"No tests configured yet\" && exit 0",
    "test:watch": "echo \"No tests configured yet\" && exit 0",
    "build": "npm run typecheck:server && vite build",
    "clean": "rimraf node_modules package-lock.json dist",
    "clean:build": "rimraf dist",
    "clean:cache": "rimraf node_modules/.vite node_modules/.cache",
    "postinstall": "echo Install complete. Next: npm run setup"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.0",
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/rapier": "^2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.87.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.20.5",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colyseus": "^0.16.4",
    "colyseus.js": "^0.16.10",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fastify": "^5.12.5",
    "firebase": "^12.19.0",
    "helmet": "^8.0.0",
    "howler": "^2.2.4",
    "ioredis": "^6.0.0",
    "jose": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "multer": "^2.4.0",
    "nanoid": "^5.0.9",
    "node-gyp": "^13.0.2",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rebuild": "^0.1.2",
    "sharp": "^0.35.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.171.0",
    "uuid": "^14.0.2",
    "wasmoon": "^1.16.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/howler": "^2.2.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@13.0.3": true
  }
}